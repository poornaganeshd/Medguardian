# ============================================================
# MedGuardian - Example environment configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit a real .env file.
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins (frontend dev server)
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database ----------
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/medguardian
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medguardian?retryWrites=true&w=majority

# ---------- Authentication ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
# Short lived token issued after a successful PIN / step-up check
STEPUP_TOKEN_TTL_MINUTES=10
BCRYPT_SALT_ROUNDS=12

# ---------- WebAuthn (biometric / platform authenticator) ----------
WEBAUTHN_RP_NAME=MedGuardian
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ---------- File uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------- OCR ----------
# Language traineddata used by Tesseract
OCR_LANG=eng
OCR_ENABLED=true

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=25

# ---------- Misc ----------
LOG_LEVEL=info
# Seed the demo drug-interaction dataset + demo knowledge base on boot
SEED_REFERENCE_DATA=true
